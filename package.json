{
  "name": "viewport-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Responsive preview and evidence-based audit workspace, Chrome extension and local companion",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node companion/server.mjs",
    "build": "tsc -b && vite build && node scripts/build-extension.mjs",
    "typecheck": "tsc -b",
    "test": "node --test tests/*.test.mjs",
    "install:browser": "playwright install chromium",
    "install:native": "node scripts/install-native.mjs",
    "icons": "node scripts/icons.mjs",
    "test:extension": "node --test tests/extension.integration.mjs"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.2",
    "ajv": "^8.17.1",
    "axe-core": "^4.10.3",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "pdfkit": "^0.17.2",
    "playwright": "^1.56.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.1.12"
  },
  "engines": {
    "node": ">=22"
  }
}

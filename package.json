{
  "name": "viewport-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Responsive preview and evidence-based audit workspace, Chrome extension and local companion",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node companion/server.mjs",
    "build": "tsc -b && vite build && node scripts/build-extension.mjs",
    "typecheck": "tsc -b",
    "test": "node --test tests/*.test.mjs",
    "install:browser": "playwright install chromium",
    "install:native": "node scripts/install-native.mjs",
    "icons": "node scripts/icons.mjs",
    "test:extension": "node --test --test-concurrency=2 tests/extension.integration.mjs tests/pdf-export.integration.mjs tests/side-panel.integration.mjs tests/flow.integration.mjs tests/recording.integration.mjs",
    "build:desktop": "tsc -b && vite build --config vite.desktop.config.ts",
    "desktop": "npm run build:desktop && node scripts/desktop.mjs",
    "package:desktop": "npm run build:desktop && electron-forge package",
    "make:desktop": "npm run build:desktop && electron-forge make && node scripts/make-dmg.mjs",
    "test:desktop": "npm run build:desktop && node --test tests/desktop.integration.mjs",
    "test:desktop:packaged": "node scripts/test-packaged-desktop.mjs",
    "test:desktop:installed": "node scripts/test-installed-desktop.mjs"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.2",
    "ajv": "^8.17.1",
    "axe-core": "^4.10.3",
    "electron-squirrel-startup": "^1.0.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "pdfkit": "^0.17.2",
    "playwright": "^1.56.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/publisher-github": "^8.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^45.2.1",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.12"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "desktop/entry.cjs",
  "productName": "Viewport Atlas",
  "author": "Viewport Atlas",
  "config": {
    "forge": "./forge.config.cjs"
  },
  "overrides": {
    "@electron/asar": {
      "glob": "^14.0.3",
      "minimatch": "^11.0.4"
    },
    "minimatch": "^11.0.4"
  }
}
